auto-install-peers=true
strict-peer-dependencies=false

# React Native / Expo Gradle autolinking runs
#   node --eval "require(require.resolve('expo-modules-autolinking', { paths: [require.resolve('expo/package.json')] }))(...)"
# from apps/mobile/android (apps/mobile/android/settings.gradle). That resolver hands
# expo's *symlinked* path (apps/mobile/node_modules/expo) to require-from-string, and
# expo/react-native.config.js then does require('expo-modules-autolinking/exports').
# In pnpm's isolated layout that package only exists next to expo's real location under
# node_modules/.pnpm, so the require throws, expo-modules-autolinking swallows the error,
# and the Android resolver falls back to inferring the import from expo/android/build.gradle's
# `namespace "expo.core"` -- producing `import expo.core.ExpoModulesPackage;`, which does not
# exist on SDK 52 and breaks :app:compileDebugJavaWithJavac on EAS.
# Hoisting expo-modules-autolinking to the root node_modules makes it resolvable from the
# symlinked expo directory, so the real packageImportPath (expo.modules) is used.
# The two defaults must be repeated: setting public-hoist-pattern replaces pnpm's defaults.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=expo-modules-autolinking
