auto-install-peers=true
strict-peer-dependencies=false

# React Native / Expo Gradle autolinking runs
#   node --eval "require(require.resolve('expo-modules-autolinking', { paths: [require.resolve('expo/package.json')] }))(...)"
# with cwd apps/mobile. (The command is declared in apps/mobile/android/settings.gradle,
# but @react-native/gradle-plugin's ReactSettingsExtension defaults workingDirectory to
# rootDirectory.dir("../"), i.e. the parent. Both cwds give the same result; the repo root
# does not, so run it from apps/mobile when checking.) That resolver hands
# expo's *symlinked* path (apps/mobile/node_modules/expo) to require-from-string, and
# expo/react-native.config.js then does require('expo-modules-autolinking/exports').
# In pnpm's isolated layout that package only exists next to expo's real location under
# node_modules/.pnpm, so the require throws, expo-modules-autolinking swallows the error,
# and the Android resolver falls back to inferring the import from expo/android/build.gradle's
# `namespace "expo.core"` -- producing `import expo.core.ExpoModulesPackage;`, which does not
# exist on SDK 52 and breaks :app:compileDebugJavaWithJavac on EAS.
# Hoisting expo-modules-autolinking to the root node_modules makes it resolvable from the
# symlinked expo directory, so the real packageImportPath (expo.modules) is used.
# The two defaults must be repeated: setting public-hoist-pattern REPLACES pnpm's defaults
# rather than extending them. Verified on pnpm 9.15.4 with clean installs: with only the
# expo-modules-autolinking line, eslint disappears from the root node_modules. Do not delete
# these two lines -- not even on a pnpm 10 bump, where the default becomes [] and repeating
# them is what keeps this repo's behaviour the same.
#
# Checking this by hand: run the command above with NODE_PATH unset and WITHOUT npx or
# pnpm exec. Both go through pnpm's bin shim, which sets NODE_PATH into the pnpm store and
# accidentally repairs the very resolution that is broken -- so a check run through them
# reports the correct import even when the build is failing.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=expo-modules-autolinking

# @sentry/react-native's Xcode build phase (sentry-xcode.sh, "Bundle React Native code and
# images") runs `node --print "require.resolve('@sentry/cli/package.json')"` from
# apps/mobile/ios. @sentry/cli is a dependency of @sentry/react-native, not of the app, so in
# pnpm's isolated layout it is only under node_modules/.pnpm and the iOS EAS build fails with
# "Cannot find module '@sentry/cli/package.json'". Hoisting it to the root node_modules makes
# it resolvable from apps/mobile/ios. Check it the same way as above: plain node, no npx or
# pnpm exec (Z9c-1, 11 Nov 2026).
public-hoist-pattern[]=@sentry/cli
