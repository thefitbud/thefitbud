# Example environment variables for local development.
# Copy to .env / apps/api/.dev.vars as needed. Never commit real secrets.

# Cloudflare (optional; wrangler local may use account cache)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_NAME=
CLOUDFLARE_QUEUE_ID=

# Firebase (emulator / test project only — never production credentials)
FIREBASE_PROJECT_ID=fitbud-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Mobile (Expo) — points at local Wrangler API for AUTH_MODE=test bearer flow
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# API local R2 (wrangler simulates under apps/api/.wrangler/state; no cloud bucket required)
# MEDIA binding + MEDIA_SIGNING_SECRET are set in apps/api/wrangler.toml [vars]

# Push provider: test uses an in-process FCM double (never production credentials locally)
# PUSH_PROVIDER_MODE=test

# API media signing (local only — never commit production secrets)
MEDIA_SIGNING_SECRET=local-dev-media-signing-secret

# Push provider (local test double only — never production FCM credentials)
PUSH_PROVIDER_MODE=test
