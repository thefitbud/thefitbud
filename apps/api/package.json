{
  "name": "@fitbud/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter thefitbud build:packages",
    "predb:reset": "pnpm --filter thefitbud build:packages",
    "presetup:local": "pnpm --filter thefitbud build:packages",
    "dev": "wrangler dev src/index.ts --local --persist-to .wrangler/state --ip 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fitbud --local --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply fitbud",
    "db:seed:library": "tsx scripts/library-seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:local": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "setup:local": "tsx scripts/ensure-dev-vars.ts"
  },
  "dependencies": {
    "@fitbud/contracts": "workspace:*",
    "@fitbud/core": "workspace:*",
    "@scalar/hono-api-reference": "0.12.10",
    "drizzle-orm": "^0.42.0",
    "hono": "^4.7.7",
    "hono-openapi": "1.3.3",
    "zod": "catalog:",
    "zod-openapi": "4.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250416.0",
    "@fitbud/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.24.0",
    "sql.js": "^1.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.29.1",
    "tsx": "^4.19.4",
    "vitest": "catalog:",
    "wrangler": "^4.12.0"
  }
}
