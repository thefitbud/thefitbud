{
  "name": "@fitbud/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run build:packages",
    "predb:reset": "pnpm -w run build:packages",
    "presetup:local": "pnpm -w run build:packages",
    "dev": "tsx scripts/local-traces.ts -- wrangler dev src/index.ts --local --persist-to .wrangler/state --ip 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts qa-smoke --max-warnings=0",
    "qa:seed": "node --experimental-strip-types --import \"data:text/javascript,import%7Bregister%7Dfrom%22node%3Amodule%22%3Bimport%7BpathToFileURL%7Dfrom%22node%3Aurl%22%3Bregister%28%22data%3Atext%2Fjavascript%2C%22%2BencodeURIComponent%28%22import%7BexistsSync%7Dfrom%5C%22node%3Afs%5C%22%3Bimport%20path%20from%5C%22node%3Apath%5C%22%3Bimport%7BfileURLToPath%7Dfrom%5C%22node%3Aurl%5C%22%3Bexport%20async%20function%20resolve%28s%2Cc%2Cn%29%7Bif%28typeof%20s%3D%3D%5C%22string%5C%22%26%26s.startsWith%28%5C%22.%5C%22%29%26%26s.endsWith%28%5C%22.js%5C%22%29%26%26c.parentURL%26%26c.parentURL.startsWith%28%5C%22file%3A%5C%22%29%29%7Bconst%20p%3Dpath.resolve%28path.dirname%28fileURLToPath%28c.parentURL%29%29%2Cs%29%3Bif%28%21existsSync%28p%29%26%26existsSync%28p.slice%280%2C-3%29%2B%5C%22.ts%5C%22%29%29return%20n%28s.slice%280%2C-3%29%2B%5C%22.ts%5C%22%2Cc%29%3B%7Dreturn%20n%28s%2Cc%29%3B%7D%22%29%2CpathToFileURL%28process.cwd%28%29%2B%22%2F%22%29%29%3B\" scripts/qa-seed.ts",
    "qa:reset": "node --experimental-strip-types --import \"data:text/javascript,import%7Bregister%7Dfrom%22node%3Amodule%22%3Bimport%7BpathToFileURL%7Dfrom%22node%3Aurl%22%3Bregister%28%22data%3Atext%2Fjavascript%2C%22%2BencodeURIComponent%28%22import%7BexistsSync%7Dfrom%5C%22node%3Afs%5C%22%3Bimport%20path%20from%5C%22node%3Apath%5C%22%3Bimport%7BfileURLToPath%7Dfrom%5C%22node%3Aurl%5C%22%3Bexport%20async%20function%20resolve%28s%2Cc%2Cn%29%7Bif%28typeof%20s%3D%3D%5C%22string%5C%22%26%26s.startsWith%28%5C%22.%5C%22%29%26%26s.endsWith%28%5C%22.js%5C%22%29%26%26c.parentURL%26%26c.parentURL.startsWith%28%5C%22file%3A%5C%22%29%29%7Bconst%20p%3Dpath.resolve%28path.dirname%28fileURLToPath%28c.parentURL%29%29%2Cs%29%3Bif%28%21existsSync%28p%29%26%26existsSync%28p.slice%280%2C-3%29%2B%5C%22.ts%5C%22%29%29return%20n%28s.slice%280%2C-3%29%2B%5C%22.ts%5C%22%2Cc%29%3B%7Dreturn%20n%28s%2Cc%29%3B%7D%22%29%2CpathToFileURL%28process.cwd%28%29%2B%22%2F%22%29%29%3B\" scripts/qa-reset.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fitbud --local --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply fitbud",
    "db:migrate:staging": "tsx scripts/deploy-env.ts migrate --env staging",
    "db:migrate:production": "tsx scripts/deploy-env.ts migrate --env production",
    "deploy:staging": "tsx scripts/deploy-env.ts deploy --env staging",
    "deploy:production": "tsx scripts/deploy-env.ts deploy --env production",
    "db:seed:library": "tsx scripts/library-seed.ts",
    "seed:library:staging": "tsx scripts/library-seed.ts --env staging --remote",
    "seed:library:production": "tsx scripts/library-seed.ts --env production --remote",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:local": "tsx scripts/seed-demo.ts",
    "db:reseed": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "setup:local": "tsx scripts/ensure-dev-vars.ts"
  },
  "dependencies": {
    "@fitbud/contracts": "workspace:*",
    "@fitbud/core": "workspace:*",
    "@scalar/hono-api-reference": "0.12.10",
    "@sentry/cloudflare": "^10.22.0",
    "drizzle-orm": "^0.42.0",
    "hono": "^4.7.7",
    "hono-openapi": "1.3.3",
    "jose": "^6.2.14",
    "zod": "catalog:",
    "zod-openapi": "4.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250416.0",
    "@fitbud/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.24.0",
    "sql.js": "^1.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.29.1",
    "tsx": "^4.19.4",
    "vitest": "catalog:",
    "wrangler": "^4.12.0"
  }
}
