{
  "slug": "fitbud",
  "version": "0.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "scheme": "fitbud",
  "icon": "../../packages/brand/app/icon.png",
  "splash": {
    "image": "../../packages/brand/app/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#FAF7F2"
  },
  "ios": {
    "supportsTablet": true
  },
  "web": {
    "bundler": "metro"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "../../packages/brand/app/adaptive-foreground.png",
      "backgroundColor": "#FAF7F2"
    }
  },
  "plugins": ["expo-dev-client"]
}
