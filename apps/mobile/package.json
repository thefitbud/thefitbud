    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^1.59.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.19.13",
    "styleq": "^0.2.1"
