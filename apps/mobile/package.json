    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo/metro-runtime": "~4.0.1",
    "@fitbud/api-client": "workspace:*",
    "@fitbud/contracts": "workspace:*",
    "@fitbud/core": "workspace:*",
    "@fitbud/tokens": "workspace:*",
    "@fitbud/ui-mobile": "workspace:*",
    "babel-preset-expo": "~12.0.0",
    "expo": "~52.0.46",
    "expo-constants": "^58.0.12",
    "expo-dev-client": "~5.0.20",
    "expo-font": "^58.0.8",
    "expo-linking": "^58.0.13",
    "expo-modules-core": "~2.2.3",
