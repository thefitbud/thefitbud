{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.3",
      "pnpm": "9.15.4",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APS_ENVIRONMENT": "development",
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.thefitbud.com",
        "EXPO_PUBLIC_TRAINER_WEB_URL": "https://app-staging.thefitbud.com"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APS_ENVIRONMENT": "development",
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.thefitbud.com",
        "EXPO_PUBLIC_TRAINER_WEB_URL": "https://app-staging.thefitbud.com"
      }
    },
    "staging-store": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "APS_ENVIRONMENT": "production",
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.thefitbud.com",
        "EXPO_PUBLIC_TRAINER_WEB_URL": "https://app-staging.thefitbud.com"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APS_ENVIRONMENT": "production",
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.thefitbud.com",
        "EXPO_PUBLIC_TRAINER_WEB_URL": "https://app.thefitbud.com"
      }
    }
  },
  "submit": {
    "staging-store": {
      "ios": {
        "appleTeamId": "26257QDTHP",
        "bundleIdentifier": "com.thefitbud.mobile.staging",
        "ascAppId": "6837745310"
      },
      "android": {
        "applicationId": "com.thefitbud.mobile.staging",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6830533558",
        "appleTeamId": "$APPLE_TEAM_ID"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "$GOOGLE_SERVICE_ACCOUNT_KEY_PATH"
      }
    }
  }
}
