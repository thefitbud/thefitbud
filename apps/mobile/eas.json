{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.thefitbud.com",
        "EXPO_PUBLIC_TRAINER_WEB_URL": "https://app-staging.thefitbud.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.thefitbud.com",
        "EXPO_PUBLIC_TRAINER_WEB_URL": "https://app-staging.thefitbud.com"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.thefitbud.com",
        "EXPO_PUBLIC_TRAINER_WEB_URL": "https://app.thefitbud.com"
      }
    }
  }
}
