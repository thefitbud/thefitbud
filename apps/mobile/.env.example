# Optional Expo public env for local API.
# Copy into a local .env (gitignored). Never commit secrets.
# Loopback is rewritten on device: Android emulator uses 10.0.2.2, and a
# phone uses the same host Metro used to load the bundle.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Trainer web link opened from the trainer More screen ("Open FitBud on web").
# Defaults to https://app.thefitbud.com; staging builds use
# https://app-staging.thefitbud.com (set per profile in eas.json).
# EXPO_PUBLIC_TRAINER_WEB_URL=
