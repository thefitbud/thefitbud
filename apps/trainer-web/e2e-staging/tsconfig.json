{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@fitbud/config/tsconfig/base.json",
  "compilerOptions": {
    // The staging Playwright suite is Node code that drives a browser: `node:fs`,
    // `node:child_process` and `process.env` on one side, `page.evaluate` bodies that
    // touch `document` and `sessionStorage` on the other.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // `types` is deliberately NOT set. apps/trainer-web does not declare `@types/node`,
    // so listing "node" here fails with TS2688; leaving `types` unset keeps TypeScript's
    // default auto-discovery, which finds `@types/node` because `@types/qrcode` declares
    // it (`/// <reference types="node" />`). That is an incidental path, not a contract —
    // if `@types/qrcode` ever goes, this project needs `@types/node` declared in
    // apps/trainer-web/package.json. See the PR for why that is not done here.
    "noEmit": true
  },
  "include": ["."]
}
