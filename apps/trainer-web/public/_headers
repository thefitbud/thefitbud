# Cloudflare Workers static assets headers (copied to dist/_headers by Vite).
# One Cache-Control rule per path; never add a catch-all /* rule, it would join with /assets/*.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
