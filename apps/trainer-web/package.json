{
  "name": "@fitbud/trainer-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run build:packages",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "eslint src worker --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run src worker",
    "test:e2e": "playwright test",
    "test:e2e:banned": "playwright test -c playwright.banned.config.ts",
    "capture:screens": "node scripts/capture-tw-screens.mjs",
    "preview": "vite preview",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "deploy:production": "pnpm build && wrangler deploy --env production"
  },
  "dependencies": {
    "@fitbud/api-client": "workspace:*",
    "@fitbud/brand": "workspace:*",
    "@fitbud/contracts": "workspace:*",
    "@fitbud/core": "workspace:*",
    "@fitbud/tokens": "workspace:*",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fitbud/config": "workspace:*",
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.3.20",
    "@types/react-dom": "~18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.24.0",
    "happy-dom": "^20.14.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.3.2",
    "vitest": "catalog:",
    "wrangler": "^4.20.0"
  }
}
