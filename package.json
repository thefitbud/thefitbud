{
  "name": "thefitbud",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "api": "pnpm --filter @fitbud/api dev",
    "web": "pnpm --filter @fitbud/trainer-web dev",
    "mobile": "pnpm --filter @fitbud/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "affected": "turbo run lint typecheck test --filter=...[HEAD^1]",
    "db:generate": "pnpm --filter @fitbud/api db:generate",
    "db:migrate:local": "pnpm --filter @fitbud/api db:migrate:local",
    "db:migrate": "pnpm --filter @fitbud/api db:migrate",
    "db:seed:library": "pnpm --filter @fitbud/api db:seed:library",
    "seed:demo": "pnpm --filter @fitbud/api seed:demo",
    "db:reset": "pnpm --filter @fitbud/api db:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
